# Local settings for `netlify dev` and `npm run gather`.
# Used only when IS_DEV_ENV is true in config/dev-env.ts (keep it false in git).
# Copy this file to .env and replace the values. .env is git-ignored: never commit real values.
# On Netlify / GitHub Actions these come from their own settings, not from this file.

# --- Admin sign-in (Netlify Functions) ---
# The only address that can sign in. Write it all lowercase (Resend's test mode compares exactly).
ADMIN_EMAIL="dummy dummy dummy"
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dummy dummy dummy"
# From resend.com → API Keys (starts with re_).
RESEND_API_KEY="dummy dummy dummy"
# Optional sender, only with a domain verified in Resend. Leave it commented to use onboarding@resend.dev.
# EMAIL_FROM="dummy dummy dummy"

# --- Saving admin changes to GitHub (Netlify Functions) ---
# Fine-grained token, this repo only: Contents + Actions read and write (starts with github_pat_).
GITHUB_TOKEN="dummy dummy dummy"
# owner/name of this repository.
GITHUB_REPO="dummy dummy dummy"

# --- Daily gather (npm run gather) ---
# From aistudio.google.com/apikey. Leave the dummy to run without AI summaries.
GEMINI_API_KEY="dummy dummy dummy"
# Optional; defaults to gemini-flash-latest.
# GEMINI_MODEL="gemini-flash-latest"
