# Copy to .env and adjust. .env is git-ignored.
# Port for `npm start` (API + built site). `npm run dev` always runs the API on 3000.
PORT=3000
# Leave empty to run in fallback mode (no AI summaries).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Dummy admin credentials: change these.
ADMIN_EMAIL=admin@keepmeupdated.local
ADMIN_PASSWORD=ChangeMe!2026
# Long random string used to sign the admin session cookie.
SESSION_SECRET=
# Daily gather schedule (local time). Default: 04:00 every day.
GATHER_CRON=0 4 * * *

# Network interface to listen on. 127.0.0.1 keeps the site and admin private to this machine;
# set 0.0.0.0 to reach it from other devices (change ADMIN_PASSWORD first).
HOST=127.0.0.1

# Markdown file with the news sources (kept in sync with Admin -> Sources).
SOURCES_FILE=sources.md
