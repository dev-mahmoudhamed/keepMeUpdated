{
  "name": "keep-me-updated",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -k -n api,web -c green,yellow \"cross-env API_PORT=3000 tsx watch server/index.ts\" \"ng serve\"",
    "build": "ng build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "ng test",
    "test:server": "vitest run -c vitest.server.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@google/genai": "^2.30.0",
    "@lucide/angular": "^1.59.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.18.1",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
